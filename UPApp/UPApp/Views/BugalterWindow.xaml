<Window x:Class="UPApp.Views.BugalterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UPApp.Views"
        mc:Ignorable="d"
        Title="Бухгалтер - Отчет по услугам" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Бухгалтер: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentUser.Name}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <Button Content="Выход" Command="{Binding LogoutCommand}" Margin="20,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Период с:" Grid.Column="0" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Margin="5,0"/>
            
            <TextBlock Text="по:" Grid.Column="2" VerticalAlignment="Center" Margin="10,0"/>
            <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Margin="5,0"/>
            
            <Button Grid.Column="4" Content="Обновить" Command="{Binding LoadServicesCommand}" Margin="10,0"/>
        </Grid>

        <ListView Grid.Row="2" ItemsSource="{Binding Services}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Штрих-код" DisplayMemberBinding="{Binding Barcode}" Width="100"/>
                    <GridViewColumn Header="Пациент" DisplayMemberBinding="{Binding PatientName}" Width="200"/>
                    <GridViewColumn Header="Услуга" DisplayMemberBinding="{Binding ServiceName}" Width="200"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding ServiceDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="150"/>
                    <GridViewColumn Header="Результат" DisplayMemberBinding="{Binding ServiceResult}" Width="100"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding ServiceStatus}" Width="100"/>
                    <GridViewColumn Header="Стоимость" DisplayMemberBinding="{Binding ServicePrice, StringFormat=\{0:C\}}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window> 