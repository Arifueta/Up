<Window x:Class="UPApp.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UPApp.Views"
        mc:Ignorable="d"
        Title="Администратор" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Администратор: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentUser.Name}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <Button Content="Выход" Command="{Binding LogoutCommand}" Margin="20,0,0,0"/>
            <Button Content="Добавить пользователя" Command="{Binding AddUserCommand}" Margin="10,0,0,0"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Users}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="100"/>
                    <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding RoleName}" Width="100"/>
                    <GridViewColumn Header="Последний вход" DisplayMemberBinding="{Binding LastEnter}" Width="150"/>
                    <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Ip}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window> 