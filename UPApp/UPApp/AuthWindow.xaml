<Window x:Class="UPApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UPApp"
        mc:Ignorable="d"
        Title="Login" Height="350" Width="300" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Login:" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" Margin="5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="5" 
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
              Visibility="{Binding IsCaptchaVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Please enter the CAPTCHA text:" Margin="5"/>
            <ContentControl Grid.Row="1" Content="{Binding CaptchaControl}" Margin="5"/>
            <Button Grid.Row="1" Content="Regenerate" Command="{Binding RegenerateCaptchaCommand}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"/>
            <TextBox Grid.Row="2" Text="{Binding CaptchaInput, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        </Grid>

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Login" Command="{Binding LoginCommand}" 
                HorizontalAlignment="Right" Width="75" Margin="5"
                IsEnabled="{Binding IsLoginEnabled}"/>
    </Grid>
</Window> 