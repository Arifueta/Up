<Window x:Class="UPApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UPApp"
        mc:Ignorable="d"
        Title="Medical Laboratory System" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="{Binding CurrentUser.Name}" Margin="5"/>
            <Button Content="Logout" Command="{Binding LogoutCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Patients" FontSize="16" FontWeight="Bold" Margin="10,10,10,0"/>
        <ListView Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding FullName}" Width="200"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="150"/>
                    <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding Phone}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Grid.Column="1" Text="Blood Samples" FontSize="16" FontWeight="Bold" Margin="10,10,10,0"/>
        <ListView Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BloodSamples}" SelectedItem="{Binding SelectedBloodSample}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Barcode" DisplayMemberBinding="{Binding Barcode}" Width="100"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Grid.Row="2" Grid.Column="1" Content="Add Blood Sample" Command="{Binding AddBloodCommand}" 
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0" Padding="10,5"/>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Services" FontSize="16" FontWeight="Bold" Margin="10,10,10,0"/>
        <ListView Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Code" DisplayMemberBinding="{Binding Code}" Width="50"/>
                    <GridViewColumn Header="Service" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat=\{0:C\}}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Add Service" Command="{Binding AddBloodServiceCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Update Service" Command="{Binding UpdateBloodServiceCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Delete Service" Command="{Binding DeleteBloodServiceCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Blood Services" FontSize="16" FontWeight="Bold" Margin="10,10,10,0"/>
        <ListView Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding BloodServices}" SelectedItem="{Binding SelectedBloodService}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Blood ID" DisplayMemberBinding="{Binding BloodId}" Width="70"/>
                    <GridViewColumn Header="Service ID" DisplayMemberBinding="{Binding ServiceId}" Width="70"/>
                    <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="70"/>
                    <GridViewColumn Header="Finished" DisplayMemberBinding="{Binding Finished, StringFormat=\{0:dd.MM.yyyy\}}" Width="150"/>
                    <GridViewColumn Header="Accepted" DisplayMemberBinding="{Binding Accepted}" Width="70"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                    <GridViewColumn Header="Analyzer" DisplayMemberBinding="{Binding Analyzer}" Width="100"/>
                    <GridViewColumn Header="User ID" DisplayMemberBinding="{Binding UserId}" Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
